# CrowCode 权限配置模板。
# 复制本文件为 settings.yaml 并去掉注释即可生效：
#   cp .crowcode/settings.yaml.example .crowcode/settings.yaml
#
# 权限规则分三层，按 本地 > 项目 > 用户 读取，合并为同一集合：
#   - 用户级：~/.crowcode/settings.yaml          （全局，所有项目生效）
#   - 项目级：<项目根>/.crowcode/settings.yaml    （可提交进 git，团队共享）
#   - 本地级：<项目根>/.crowcode/settings.local.yaml （已 gitignore；「永久允许」写入这里）
#
# 规则格式：Tool(pattern) 或 Tool（不带模式段匹配该工具全部调用）。
#   Tool 为友好名：Bash / Read / Write / Edit / Glob / Grep
#   模式段支持精确匹配与 glob（* 任意串；文件路径 ** 跨目录段）。
# 裁决优先级：任一层的 deny 压过所有层的 allow（deny 全局优先）。
#
# 只读类（Read/Glob/Grep）默认即 Allow，allow 规则主要用于提前放行 Bash/Write；
# deny 规则可对只读做围栏（如 Read(.env) 禁止读密钥文件）。

default_mode: default  # 可选：default / acceptEdits / plan / bypassPermissions

permissions:
  allow:
    - Bash(git *)
    - Bash(pytest)
  deny:
    - Bash(rm *)
    - Read(.env)
    - Write(.env)
